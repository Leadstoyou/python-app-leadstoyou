{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Cove Video Editor",
      "type": "debugpy",
      "request": "launch",
      "module": "cove_video_editor",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "env": {
        "PYTHONPATH": "${workspaceFolder}\\src",
        "PATH": "${workspaceFolder}\\ffmpeg;${env:PATH}"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Cove Video Editor (auto-reload)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}\\scripts\\dev_reload.py",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "env": {
        "PYTHONPATH": "${workspaceFolder}\\src",
        "PATH": "${workspaceFolder}\\ffmpeg;${env:PATH}"
      },
      "console": "integratedTerminal",
      "justMyCode": true,
      "subProcess": false
    }
  ]
}
